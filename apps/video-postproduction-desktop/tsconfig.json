{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "module": "Node20",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "scripts/**/*.js",
    "tests/**/*.js",
    "forge.config.js"
  ],
  "exclude": ["dist", "node_modules"]
}
