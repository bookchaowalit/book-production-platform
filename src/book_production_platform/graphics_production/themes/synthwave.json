{
  "schema_version": "graphic-theme.v1",
  "theme_id": "synthwave",
  "title": "Synthwave poster",
  "description": "Retro neon poster: striped sun, wireframe mountains, perspective grid, chrome title.",
  "ir_version": "graphic-ir.v2",
  "template_version": "1",
  "variants": ["square", "portrait", "story", "landscape"],
  "evidence": ["synthwave", "retrowave", "outrun", "neon poster", "ซินธ์เวฟ", "นีออน", "ย้อนยุค 80"],
  "slots": {
    "headline": {"required": true, "labels": ["headline", "title", "หัวข้อ", "พาดหัว"]},
    "headline2": {"required": false, "labels": ["second line", "line 2", "บรรทัดสอง"]},
    "subhead": {"required": false, "labels": ["subhead", "subtitle", "tagline", "คำโปรย", "ซับไตเติล"]},
    "tag": {"required": false, "labels": ["tag", "badge", "ป้าย"]},
    "footer": {"required": false, "labels": ["footer", "website", "ท้ายภาพ", "เว็บไซต์"]}
  },
  "palette": {
    "night": "#05010F", "dusk": "#1A0638", "plum": "#5B0F6B", "pink": "#FF2E88", "cyan": "#22E4FF",
    "magenta": "#FF4FD8", "gold": "#FFF35C", "ink": "#FFE7FB"
  },
  "paints": [
    {"paint_id": "sky", "type": "linear", "stops": [
      {"offset": 0, "color": "palette.night"}, {"offset": 0.45, "color": "palette.dusk"},
      {"offset": 0.78, "color": "palette.plum"}, {"offset": 1, "color": "palette.pink"}]},
    {"paint_id": "sun", "type": "linear", "stops": [
      {"offset": 0, "color": "palette.gold"}, {"offset": 0.45, "color": "#FF9A3C"}, {"offset": 1, "color": "palette.pink"}]},
    {"paint_id": "floor", "type": "linear", "stops": [{"offset": 0, "color": "#2A0640"}, {"offset": 1, "color": "#07010F"}]},
    {"paint_id": "grid", "type": "linear", "stops": [
      {"offset": 0, "color": "palette.magenta", "opacity": 0.35}, {"offset": 1, "color": "palette.cyan"}]},
    {"paint_id": "chrome", "type": "linear", "stops": [
      {"offset": 0, "color": "#E9FBFF"}, {"offset": 0.46, "color": "#7FD8FF"}, {"offset": 0.5, "color": "#1B1F5E"},
      {"offset": 0.56, "color": "#FF7AD9"}, {"offset": 1, "color": "#FFF2FB"}]},
    {"paint_id": "mount", "type": "linear", "stops": [{"offset": 0, "color": "#3B0D5C"}, {"offset": 1, "color": "#12031F"}]},
    {"paint_id": "haze", "type": "linear", "stops": [
      {"offset": 0, "color": "palette.pink", "opacity": 0}, {"offset": 1, "color": "palette.pink", "opacity": 0.45}]}
  ],
  "vars": {
    "S": "MIN / 1080",
    "HZ": {"by_variant": {"landscape": "H * 0.71", "story": "H * 0.66", "default": "H * 0.637"}},
    "TOP": {"by_variant": {"landscape": "H * 0.05", "story": "H * 0.14", "default": "H * 0.06"}},
    "SUN_R": {"by_variant": {"landscape": "MIN * 0.17", "default": "MIN * 0.2"}},
    "SUN_Y": "HZ - 30 * S",
    "T1": {"by_variant": {"landscape": "MIN * 0.15", "default": "MIN * 0.176"}},
    "T2": {"by_variant": {"landscape": "MIN * 0.12", "default": "MIN * 0.139"}},
    "SUB_Y": {"if_slot": "headline2", "then": "TOP + T1 * 1.02 + T2 * 1.2", "else": "TOP + T1 * 1.15"}
  },
  "layers": [
    {"id": "Background", "items": [{"motif": "rect", "id": "sky", "fill": "paint:sky"}]},
    {"id": "Stars", "items": [
      {"motif": "starfield", "id": "stars", "height": "HZ - 240 * S", "count": "120 * W * H / 1458000", "sparkles": 3,
       "sparkle_size": "14 * S"}]},
    {"id": "Sun", "items": [
      {"motif": "glow", "id": "sun-glow", "cx": "CX", "cy": "SUN_Y", "r": "SUN_R * 1.9", "color": "palette.pink"},
      {"motif": "striped_sun", "id": "sun", "cx": "CX", "cy": "SUN_Y", "r": "SUN_R", "cut_y": "HZ",
       "slat_start": "SUN_Y - SUN_R * 0.53", "fill": "paint:sun", "first_gap": "5 * S", "first_band": "24 * S",
       "gap_growth": "3.4 * S", "band_shrink": "2.2 * S", "min_band": "10 * S"}]},
    {"id": "Mountains", "items": [
      {"motif": "ridge", "id": "mountains-left", "base": "HZ", "fill": "paint:mount", "stroke": "palette.magenta",
       "points": [[0, "HZ - 60 * S"], ["W * 0.065", "HZ - 80 * S"], ["W * 0.139", "HZ - 48 * S"], ["W * 0.222", "HZ - 160 * S"],
                  ["W * 0.306", "HZ - 70 * S"], ["W * 0.361", "HZ - 100 * S"], ["W * 0.398", "HZ"]]},
      {"motif": "ridge", "id": "mountains-right", "base": "HZ", "fill": "paint:mount", "stroke": "palette.cyan",
       "points": [["W * 0.602", "HZ"], ["W * 0.648", "HZ - 90 * S"], ["W * 0.722", "HZ - 55 * S"], ["W * 0.815", "HZ - 170 * S"],
                  ["W * 0.889", "HZ - 90 * S"], ["W * 0.944", "HZ - 125 * S"], ["W", "HZ - 70 * S"]]},
      {"motif": "rect", "id": "haze", "y": "HZ - 140 * S", "height": "140 * S", "fill": "paint:haze"}]},
    {"id": "Grid", "items": [
      {"motif": "perspective_grid", "id": "grid", "horizon": "HZ", "floor": "paint:floor", "vertical_color": "paint:grid",
       "horizontal_color": "palette.cyan", "horizon_color": "#FF9BE3", "spread": "W * 0.25", "near_spread": "W * 0.37",
       "verticals": 14, "horizontals": 17, "stroke_width": "2 * S"}]},
    {"id": "Title", "items": [
      {"motif": "display_text", "id": "headline", "slot": "headline", "x": "W * 0.04", "y": "TOP", "width": "W * 0.92",
       "height": "T1 * 1.25", "font_size": "T1", "min_font_size": "T1 * 0.45", "max_lines": 1, "font": "builtin:display",
       "weight": "black", "letter_spacing": "6 * S", "align": "center", "color": "paint:chrome", "stroke": "#FFFFFF",
       "stroke_width": "2 * S",
       "shadows": [{"dx": "10 * S", "dy": "12 * S", "color": "palette.pink", "opacity": 0.9},
                   {"dx": "5 * S", "dy": "6 * S", "color": "palette.cyan", "opacity": 0.9}]},
      {"motif": "display_text", "id": "headline2", "slot": "headline2", "x": "W * 0.04", "y": "TOP + T1 * 1.02",
       "width": "W * 0.92", "height": "T2 * 1.25", "font_size": "T2", "min_font_size": "T2 * 0.45", "max_lines": 1,
       "font": "builtin:display", "weight": "black", "letter_spacing": "10 * S", "align": "center", "color": "paint:chrome",
       "stroke": "#FFFFFF", "stroke_width": "2 * S",
       "shadows": [{"dx": "10 * S", "dy": "12 * S", "color": "palette.pink", "opacity": 0.9},
                   {"dx": "5 * S", "dy": "6 * S", "color": "palette.cyan", "opacity": 0.9}]}]},
    {"id": "Subtitle", "items": [
      {"motif": "text_block", "id": "subhead", "slot": "subhead", "x": "W * 0.06", "y": "SUB_Y",
       "width": "W * 0.88", "height": "MIN * 0.06", "font_size": "MIN * 0.041", "min_font_size": "MIN * 0.025",
       "max_lines": 1, "font": "builtin:thai", "weight": "bold", "letter_spacing": "2 * S", "align": "center",
       "color": "palette.ink"},
      {"motif": "rect", "id": "tag-pill", "x": "CX - MIN * 0.176", "y": "SUB_Y + MIN * 0.075",
       "width": "MIN * 0.352", "height": "MIN * 0.041", "rx": "MIN * 0.02", "fill": "none", "stroke": "palette.cyan",
       "stroke_width": "2 * S", "when": {"slot": "tag"}},
      {"motif": "text_block", "id": "tag", "slot": "tag", "x": "CX - MIN * 0.17", "y": "SUB_Y + MIN * 0.083",
       "width": "MIN * 0.34", "height": "MIN * 0.026", "font_size": "MIN * 0.0185", "min_font_size": "MIN * 0.012",
       "max_lines": 1, "font": "builtin:mono", "letter_spacing": "8 * S", "align": "center", "color": "palette.cyan"}]},
    {"id": "Frame", "items": [
      {"motif": "corner_frame", "id": "frame", "inset": "28 * S", "length": "60 * S", "color": "palette.magenta",
       "stroke_width": "5 * S", "border": "#FFFFFF", "border_width": "2 * S"},
      {"motif": "text_block", "id": "footer", "slot": "footer", "x": "W * 0.5", "y": "H - 72 * S", "width": "W * 0.45",
       "height": "24 * S", "font_size": "16 * S", "min_font_size": "11 * S", "max_lines": 1, "font": "builtin:mono",
       "letter_spacing": "4 * S", "align": "right", "color": "#FFFFFF", "opacity": 0.75}]}
  ]
}
