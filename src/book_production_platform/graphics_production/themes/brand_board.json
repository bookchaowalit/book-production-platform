    "G": "MIN * 0.03",
    "R": "MIN * 0.035",
    "CW": "(W - 2 * M - 2 * G) / 3",
    "RH": "(H - 2 * M - 2 * G) / 3",
    "C1": "M",
    "C2": "M + CW + G",
    "C3": "M + 2 * (CW + G)",
    "R1": "M",
    "R2": "M + RH + G",
    "R3": "M + 2 * (RH + G)"
