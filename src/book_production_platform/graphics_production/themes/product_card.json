{
  "schema_version": "graphic-theme.v1",
  "theme_id": "product_card",
  "title": "Product card",
  "description": "Product name and price, with an optional product image above them (original V1A template).",
  "ir_version": "graphic-ir.v1",
  "template_version": "2",
  "renderer": "graphics-svg-browser-v2",
  "variants": ["square", "portrait", "story"],
  "evidence": ["product card", "product", "การ์ดสินค้า", "สินค้า"],
  "slots": {
    "title": {"required": true, "labels": ["title", "name", "product", "ชื่อสินค้า", "ชื่อ"]},
    "price": {"required": true, "labels": ["price", "ราคา"]}
  },
  "assets": {"product_image": {"required": false}},
  "layers": [
    {"id": "Background", "items": [
      {"motif": "rect", "id": "background", "fill": "brand.background"},
      {"motif": "rect", "id": "accent-bar", "height": 26, "fill": "brand.accent"}
    ]},
    {"id": "Image", "items": [
      {"motif": "image", "id": "product-image", "asset": "product_image", "x": 72, "y": 150, "width": 936, "height": 470,
       "when": {"asset": "product_image"}}
    ]},
    {"id": "Text", "items": [
      {"motif": "text_block", "id": "product-title", "slot": "title", "x": 72,
       "y": {"if_asset": "product_image", "then": 670, "else": 260}, "width": 936, "height": 160,
       "font_size": 62, "min_font_size": 30, "max_lines": 4, "color": "brand.foreground", "align": "center"},
      {"motif": "text_block", "id": "product-price", "slot": "price", "x": 72,
       "y": {"if_asset": "product_image", "then": 850, "else": 470}, "width": 936, "height": 140,
       "font_size": 72, "min_font_size": 32, "max_lines": 3, "color": "brand.accent", "align": "center"}
    ]}
  ]
}
