{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:book-audio-production:audio-batch.v1",
  "title": "Audio batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "tracks"],
  "properties": {
    "schema_version": {"const": "audio-batch.v1"},
    "batch_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/track"}
    }
  },
  "$defs": {
    "trim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_ms": {"type": ["integer", "null"]},
        "end_ms": {"type": ["integer", "null"]}
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integrated_lufs", "true_peak_dbtp"],
      "properties": {
        "integrated_lufs": {"type": "number"},
        "true_peak_dbtp": {"type": "number"},
        "lra_lu": {"type": ["number", "null"]}
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id", "source", "targets", "output_format"],
      "properties": {
        "track_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "source": {"type": "string", "minLength": 1},
        "trim": {"anyOf": [{"$ref": "#/$defs/trim"}, {"type": "null"}]},
        "targets": {"$ref": "#/$defs/targets"},
        "output_format": {"enum": ["flac", "wav_pcm24"]}
      }
    }
  }
}
