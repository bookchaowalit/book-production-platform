FROM node:22-alpine

WORKDIR /app
COPY apps/video-postproduction-web/package*.json ./
RUN npm ci
COPY apps/video-postproduction-web/ ./

ARG NEXT_PUBLIC_VIDEO_POSTPRODUCTION_API_ORIGIN=http://localhost:8000
ENV NEXT_PUBLIC_VIDEO_POSTPRODUCTION_API_ORIGIN=$NEXT_PUBLIC_VIDEO_POSTPRODUCTION_API_ORIGIN

RUN npm run build

EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=6 \
  CMD wget -qO- http://127.0.0.1:3000/ >/dev/null

CMD ["./node_modules/.bin/next", "start", "--hostname", "0.0.0.0", "--port", "3000"]
