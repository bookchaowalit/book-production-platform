{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solo-empire:document-production:transcript-document-request.v1",
  "title": "TranscriptDocumentRequest v1",
  "description": "Structured request for a deterministic, verbatim, timestamped transcript document rendered by the Documents service. Segment ordering (end_seconds > start_seconds) is a semantic rule enforced by the receiving validator in addition to this structural schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "title", "issue_date", "source_name", "segments"],
  "properties": {
    "schema_version": {"const": "transcript-document-request.v1"},
    "document_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "locale": {"type": "string", "minLength": 2, "maxLength": 35},
    "issue_date": {"type": "string", "format": "date"},
    "source_name": {"type": "string", "minLength": 1, "maxLength": 200},
    "language": {"type": ["string", "null"], "minLength": 2, "maxLength": 35},
    "source_tool": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_seconds", "end_seconds", "text"],
        "properties": {
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number"},
          "text": {"type": "string", "minLength": 1, "maxLength": 2000},
          "speaker": {"type": ["string", "null"], "minLength": 1, "maxLength": 120}
        }
      }
    }
  }
}
