{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solo-empire:production-pipelines:pipeline-report-config.v1",
  "title": "PipelineReportConfig v1",
  "description": "Monthly report pipeline job configuration (T6.3). The chart aggregation semantic rules (y_column required and numeric for sum/avg, x_column/y_column must exist in dataset columns) are enforced by the receiving validator in addition to this structural schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pipeline_id", "dataset", "chart", "workbook", "document"],
  "properties": {
    "schema_version": {"const": "pipeline-report-config.v1"},
    "pipeline_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "stage_timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 900},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "title", "columns", "csv_text"],
      "properties": {
        "dataset_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "delimiter": {"enum": [",", ";", "\t"]},
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label", "data_type"],
            "properties": {
              "key": {"type": "string", "minLength": 1, "maxLength": 100},
              "label": {"type": "string", "minLength": 1, "maxLength": 200},
              "data_type": {"enum": ["text", "integer", "decimal", "date", "boolean"]},
              "required": {"type": "boolean"},
              "source_name": {"type": ["string", "null"], "minLength": 1, "maxLength": 200}
            }
          }
        },
        "transforms": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["op"],
            "properties": {
              "op": {"enum": ["trim_text", "fill_null", "filter_equals", "sort_by"]},
              "column": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
              "value": {},
              "direction": {"enum": ["asc", "desc"]}
            }
          }
        },
        "csv_text": {"type": "string", "minLength": 1, "maxLength": 2000000},
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_column", "title"],
      "properties": {
        "chart_type": {"enum": ["bar", "line"]},
        "x_column": {"type": "string", "minLength": 1, "maxLength": 100},
        "y_column": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
        "aggregation": {"enum": ["sum", "count", "avg"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "x_axis_label": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
        "y_axis_label": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
        "value_unit": {"type": ["string", "null"], "minLength": 1, "maxLength": 32},
        "width": {"type": "integer", "minimum": 240, "maximum": 4096},
        "height": {"type": "integer", "minimum": 180, "maximum": 4096}
      }
    },
    "workbook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workbook_id", "title"],
      "properties": {
        "workbook_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "locale": {"type": "string", "minLength": 2, "maxLength": 35},
        "column_keys": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "title", "currency", "customer_name", "issue_date"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "locale": {"type": "string", "minLength": 2, "maxLength": 35},
        "currency": {"type": "string", "minLength": 1, "maxLength": 12},
        "customer_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "issue_date": {"type": "string", "format": "date"},
        "summary_lines": {
          "type": "array",
          "maxItems": 40,
          "items": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    }
  }
}
