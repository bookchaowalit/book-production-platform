{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solo-empire:production-pipelines:pipeline-report.v1",
  "title": "PipelineReport v1",
  "description": "Pipeline manifest for the T6.3 monthly report chain. Links each stage job and artifact identity; every path is relative to the published run directory and must not be absolute, contain a drive letter, or use backslashes. The stage order (data_pipeline, data_viz, spreadsheet, documents) is enforced by the receiving validator in addition to this structural schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pipeline_id", "config_hash", "model_calls", "stages"],
  "properties": {
    "schema_version": {"const": "pipeline-report.v1"},
    "pipeline_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "config_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model_calls": {"const": 0},
    "stages": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "status",
          "tool",
          "command",
          "input_contract",
          "output_contract",
          "request_path",
          "manifest_path",
          "job_id",
          "artifacts"
        ],
        "properties": {
          "stage": {"enum": ["data_pipeline", "data_viz", "spreadsheet", "documents"]},
          "status": {"const": "accepted"},
          "tool": {"type": "string", "minLength": 1, "maxLength": 200},
          "command": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {"type": "string", "minLength": 1, "maxLength": 500}
          },
          "input_contract": {"type": "string", "minLength": 1, "maxLength": 80},
          "output_contract": {"type": "string", "minLength": 1, "maxLength": 80},
          "request_path": {"type": "string", "minLength": 1, "maxLength": 500},
          "manifest_path": {"type": "string", "minLength": 1, "maxLength": 500},
          "job_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "path", "media_type", "content_hash", "byte_size"],
              "properties": {
                "name": {"type": "string", "minLength": 1, "maxLength": 255},
                "path": {"type": "string", "minLength": 1, "maxLength": 500},
                "media_type": {"type": "string", "minLength": 1, "maxLength": 120},
                "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "byte_size": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    }
  }
}
