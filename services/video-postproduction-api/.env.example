# Local development defaults only. Never commit real credentials or provider keys.
POSTGRES_USER=video
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=video_postproduction
DATABASE_URL=postgresql+psycopg://video:change-me-local-only@postgres:5432/video_postproduction
REDIS_URL=redis://redis:6379/0
STORAGE_ROOT=/app/storage
MAX_UPLOAD_BYTES=2147483648
ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/quicktime,video/webm,video/x-matroska
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3400,http://localhost:3400
TRANSCRIPTION_PROVIDER=faster_whisper
TRANSCRIPTION_LANGUAGE=
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
VIDEO_EDITOR_API_TOKEN=
FFPROBE_EXECUTABLE=ffprobe
FFMPEG_EXECUTABLE=ffmpeg
JOB_LEASE_SECONDS=900
MAX_STAGE_ATTEMPTS=3
