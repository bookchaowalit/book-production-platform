{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solo-empire.local/schemas/document-production/document-request.v1.json",
  "title": "DocumentRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["template_id", "template_version", "document_id", "currency", "title", "customer_name", "issue_date", "line_items"],
  "properties": {
    "schema_version": {"type": "string", "const": "document-request.v1"},
    "template_id": {"type": "string", "minLength": 1},
    "template_version": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "locale": {"type": "string", "minLength": 2},
    "currency": {"type": "string", "enum": ["THB", "USD", "EUR"]},
    "title": {"type": "string", "minLength": 1},
    "customer_name": {"type": "string", "minLength": 1},
    "issue_date": {"type": "string", "format": "date"},
    "line_items": {"type": "array", "minItems": 1, "maxItems": 100},
    "notes": {"type": ["string", "null"]}
  }
}
